{
    "name": "muon/module-dev-profiler",
    "description": "Headless storefront request profiler: theme fallback forensics and full-page-cache verdicts, captured per request and read from the CLI. Developer mode only.",
    "type": "magento2-module",
    "license": "OSL-3.0",
    "version": "1.1.1",
    "authors": [
        {
            "name": "Serge Autushka",
            "email": "s.autushka@gmail.com"
        }
    ],
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
        "magento/framework": "^103.0.9",
        "magento/module-developer": "^100.4.9",
        "magento/module-page-cache": "^100.4.9",
        "magento/module-store": "^101.1.9",
        "magento/module-theme": "^101.1.9"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Muon\\DevProfiler\\": ""
        }
    }
}
