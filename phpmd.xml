<?xml version="1.0"?>
<ruleset name="Custom Magento module PHPMD ruleset"
         xmlns="http://pmd.sf.net/ruleset/1.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0 http://pmd.sf.net/ruleset_xml_schema.xsd"
         xsi:noNamespaceSchemaLocation="http://pmd.sf.net/ruleset_xml_schema.xsd">
    <description>
        Default PHPMD ruleset shipped into published Magento 2 modules so the standalone repo's CI
        reproduces the monorepo quality bar regardless of the installed PHPMD version. Mirrors the
        monorepo ruleset (phpmd.xml), with Magento-friendly exclusions. A module may override it by
        committing its own phpmd.xml.
    </description>

    <rule ref="rulesets/cleancode.xml"/>
    <rule ref="rulesets/design.xml"/>
    <rule ref="rulesets/unusedcode.xml"/>

    <rule ref="rulesets/codesize.xml">
        <!-- Unit-test classes legitimately carry one public test method per scenario. -->
        <exclude name="TooManyPublicMethods"/>
        <exclude name="ExcessivePublicCount"/>
    </rule>

    <rule ref="rulesets/naming.xml">
        <!-- Magento idioms: short loop/exception vars ($e, $id, $qty) and intentionally
             descriptive long names are pervasive in the framework's conventions. -->
        <exclude name="ShortVariable"/>
        <exclude name="LongVariable"/>
        <!-- Same reasoning, applied to method names. A unit test's name is its documentation:
             testHasActivityIsFalseWhenEveryBucketIsZeroFilled states the scenario, and squeezing it
             under the 40-character default would cost the reader more than the rule returns. -->
        <exclude name="LongMethodName"/>
    </rule>
</ruleset>
